generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ContactType {
  EMAIL
  PHONE
}

enum ClinicUserType {
  ADMIN
  DOCTOR
  NURSE
  RECEPTIONIST
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum OtpPurpose {
  LOGIN
  PHONE_VERIFICATION
  PASSWORD_RESET
}

enum AppointmentStatus {
  BOOKED
  APPROVED
  REJECTED
  COMPLETED
  NOT_SHOW
  CANCELLED
}

enum AppointmentCreatedByType {
  CLINIC_USER
  PATIENT
  ADMIN_USER
  SYSTEM
}

enum NotificationType {
  SMS
  EMAIL
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}


model Clinic {
  id          String   @id @default(uuid())
  name        String
  description String?
  address     String?
  isActive    Boolean  @default(true)
  image       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  doctorAvailabilities DoctorAvailability[]
  clinicUsers          ClinicUser[]
  clinicContacts       ClinicContact[]
  services             Service[]
  patients             Patient[]
  appointments         Appointment[]
  notifications        Notification[]
  specialties Specialty[]
  doctorBlockedTimes   DoctorBlockedTime[]
  clinicSetting        ClinicSetting?
  articles Article[]
}

model AdminUser {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  email        String?  @unique
  phone        String?
  avatar       String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ClinicUser {
  id           String         @id @default(uuid())
  clinicId     String 
  firstName    String
  lastName     String 
  passwordHash String
  email        String
  phone        String?
  type         ClinicUserType
  avatar       String?
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id])

  availabilities       DoctorAvailability[]
  doctorAppointments   Appointment[] @relation("AppointmentDoctor")
  notifications        Notification[]
  specialties Specialty[]
  blockedTimes   DoctorBlockedTime[]

  @@index([clinicId])
}

model ClinicContact {
  id          String      @id @default(uuid())
  clinicId    String
  name        String
  contactType ContactType
  value       String
  isPrimary   Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@index([clinicId])
  @@unique([clinicId, contactType, value])
}

model Service {
  id          String   @id @default(uuid())
  clinicId    String
  name        String
  description String?
  price       Decimal? @db.Decimal(10, 2)
  duration    Int?
  image       String?
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@index([clinicId])
}

model DoctorAvailability {
  id           String    @id @default(uuid())
  clinicId     String
  doctorId     String
  dayOfWeek    DayOfWeek
  startTime    String
  endTime      String
  isActive     Boolean   @default(true)
  durationSlot Int       @default(15)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  doctor ClinicUser @relation(fields: [doctorId], references: [id])
  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@index([clinicId])
  @@index([doctorId])
}

model Patient {
  id          String   @id @default(uuid())
  clinicId    String
  firstName   String
  lastName    String
  phone       String
  address     String?
  dateOfBirth DateTime?
  avatar      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id])

  appointments  Appointment[]  @relation("AppointmentPatient")
  notifications Notification[]

  @@index([clinicId])
  @@index([phone])
}

model Otp {
  id         String     @id @default(uuid())
  phone      String
  codeHash   String
  purpose    OtpPurpose
  expiresAt  DateTime
  verifiedAt DateTime?
  attempts   Int        @default(0)
  createdAt  DateTime   @default(now())

  @@index([phone, purpose])
  @@index([expiresAt])
}

model Appointment {
  id        String   @id @default(uuid())
  clinicId  String
  doctorId  String
  patientId String

  subject     String?
  description String?
  status      AppointmentStatus @default(BOOKED)

  createdByType        AppointmentCreatedByType

  date      DateTime
  startTime String
  endTime   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cancelledAt        DateTime?
  cancellationReason String?

  rejectedAt        DateTime?
  rejectionReason   String?

  clinic        Clinic         @relation(fields: [clinicId], references: [id])
  doctor        ClinicUser     @relation("AppointmentDoctor", fields: [doctorId], references: [id])
  patient       Patient        @relation("AppointmentPatient", fields: [patientId], references: [id])
  notifications Notification[]

  @@index([clinicId])
  @@index([doctorId])
  @@index([patientId])
  @@index([date])
  @@index([status])
}

model Notification {
  id            String             @id @default(uuid())
  clinicId      String?
  patientId     String?
  clinicUserId  String?
  appointmentId String?

  type          NotificationType
  recipient     String
  subject       String?
  content       String
  status        NotificationStatus @default(PENDING)
  errorMessage  String?
  sentAt        DateTime?

  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  clinic        Clinic?      @relation(fields: [clinicId], references: [id])
  patient       Patient?     @relation(fields: [patientId], references: [id])
  clinicUser    ClinicUser?  @relation(fields: [clinicUserId], references: [id])
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])

  @@index([clinicId])
  @@index([patientId])
  @@index([clinicUserId])
  @@index([appointmentId])
  @@index([status])
  @@index([type])
}


model Specialty {
  id          String   @id @default(uuid())
  clinicId    String
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clinic  Clinic       @relation(fields: [clinicId], references: [id])
  doctors ClinicUser[]

  @@index([clinicId])
  @@unique([clinicId, name])
}

model DoctorBlockedTime {
  id        String   @id @default(uuid())

  clinicId  String
  doctorId  String

  startDate DateTime
  endDate   DateTime

  reason    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinic Clinic     @relation(fields: [clinicId], references: [id])
  doctor ClinicUser @relation(fields: [doctorId], references: [id])

  @@index([clinicId])
  @@index([doctorId])
  @@index([startDate, endDate])
}

model ClinicSetting {
  id       String @id @default(uuid())
  clinicId String @unique

  allowPatientBooking   Boolean @default(true)
  showArticle   Boolean @default(true)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id])
}


model Article {
  id          String        @id @default(uuid())
  clinicId    String
  title       String
  content  String
  image       String?
  status      ArticleStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@index([clinicId])
  @@index([status])
}